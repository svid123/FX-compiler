root=({any_root_sentence} | {exception_symbols})*[ETN_NONE]<

any_root_sentence={var_func_definition} | {kw_typedef} | {static_attr} | {kw_enum} | {kw_cbuffer} | {kw_sampler} | {kw_rasterstate} | {kw_blendstate} | {kw_depthstencilstate} | {kw_technique} | {empty_sentence}

empty_sentence=[ETN_SEMICOLON]
any_sentence={block} | {sentence} | {empty_sentence}
block=[ETN_BLOCK_OPEN]{any_sentence}*[ETN_BLOCK_CLOSE]


sentence={var_def} | {static_attr} | {kw_typedef} | {single_expression} | {kw_if} | {kw_for} | {kw_return} | {kw_else} | {kw_break} | {kw_do} | {kw_while} | {kw_switch} | {kw_case} | {kw_default} | {kw_continue}

exception_symbols=[ETN_INVALID-ETN_CONST_LAST]


;  used under keywords: kw(...)
kw_expression=({kw_expr_block} | {kw_expr_block_array} | {kw_expr_block_chars})+
kw_expr_block=[ETN_BRACEC_OPEN] ({kw_expr_block} | {kw_expr_block_array} | {kw_expr_block_chars})* [ETN_BRACEC_CLOSE]
kw_expr_block_array=[ETN_BRACES_OPEN] ({kw_expr_block} | {kw_expr_block_array} | {kw_expr_block_chars})+ [ETN_BRACES_CLOSE]
kw_expr_block_chars=[ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_COMMA]

;kw_const_expression=({kw_cexpr_block} | {kw_cexpr_block_chars})+
;kw_cexpr_block=[ETN_BRACEC_OPEN] ({kw_cexpr_block} | {kw_cexpr_block_chars})* [ETN_BRACEC_CLOSE]
kw_cexpr_block_chars=[ETN_ID, ETN_OP_PLUS-ETN_OP_OR, ETN_OP_GATE-ETN_CONST_DOUBLE_E, ETN_BRACES_OPEN-ETN_BRACES_CLOSE, ETN_COMMA]

static_attr=[ETN_BRACES_OPEN] [ETN_ID, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_BRACEC_OPEN,ETN_BRACEC_CLOSE, ETN_COMMA]+ [ETN_BRACES_CLOSE]

;  used as single statements: ...;
single_expression={single_expression_no_array}


single_expression_no_array={expr_chars}*[ETN_SEMICOLON]
expr_chars=[ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_BRACEC_OPEN-ETN_BRACES_CLOSE, ETN_COMMA]

const_expression=(([ETN_BRACEC_OPEN] {const_expression} [ETN_BRACEC_CLOSE]) | [ETN_ID, ETN_OP_PLUS-ETN_CONST_DOUBLE_E])+

template_expression=([ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_OP_ELSE, ETN_OP_INC-ETN_CONST_DOUBLE_E, ETN_BRACEC_OPEN-ETN_BRACES_CLOSE, ETN_COMMA])+



under_const_expr={kw_expression}


var_func_definition={var_def} | {func_def}
type={kw_struct} | ([ETN_KW_SIGNED,ETN_KW_UNSIGNED]? ([ETN_ID, ETN_KW_VOID]) ([ETN_OP_LESS] {template_expression} [ETN_OP_GATE])?)
arg_type=[ETN_KW_SIGNED,ETN_KW_UNSIGNED,ETN_KW_TRIANGLE-ETN_KW_POINT]? ([ETN_ID, ETN_KW_VOID, ETN_KW_SAMPLER, ETN_KW_SAMPLERSTATE, ETN_KW_SAMPLERCMPSTATE]) ([ETN_OP_LESS] {template_expression} [ETN_OP_GATE])?

func_def={func_name} {block}
func_name={var_qualified_type} [ETN_ID] [ETN_BRACEC_OPEN] {args}? [ETN_BRACEC_CLOSE] ([ETN_OP_ELSE] [ETN_ID])?

init_expr={init_block} | {init_data}
init_data=({init_braces} | {init_chars})+
init_braces=[ETN_ID]? [ETN_BRACEC_OPEN] ({init_braces} | {init_chars_braced})* [ETN_BRACEC_CLOSE]
init_chars=[ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_BRACES_OPEN-ETN_BRACES_CLOSE]
init_chars_braced=[ETN_ID, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_BRACES_OPEN-ETN_BRACES_CLOSE, ETN_COMMA]
init_block=[ETN_BLOCK_OPEN] ({init_expr} ([ETN_COMMA] {init_expr})*)? [ETN_BLOCK_CLOSE]

array_dim=[ETN_BRACES_OPEN] {kw_expression}? [ETN_BRACES_CLOSE]
init_list=[ETN_OP_ASSIGN] ({init_block} | {init_data})
register_def=[ETN_KW_REGISTER] [ETN_BRACEC_OPEN] [ETN_ID] ([ETN_COMMA] [ETN_ID])? [ETN_BRACEC_CLOSE]
semantic_def=[ETN_ID]
var_def_id=[ETN_ID] {array_dim}* ([ETN_OP_ELSE] ({register_def} | {semantic_def}))? {init_list}?
var_qualified_type=[ETN_KW_UNIFORM-ETN_KW_VOLATILE]* [ETN_KW_CONST-ETN_KW_COLMAJOR]* {type}
id_def={var_qualified_type}  ({var_def_id} ([ETN_COMMA] {var_def_id})*)?
id_def_strict={var_qualified_type}  {var_def_id} ([ETN_COMMA] {var_def_id})*
var_def= {id_def} [ETN_SEMICOLON]

kw_typedef=[ETN_KW_TYPEDEF] {id_def_strict} [ETN_SEMICOLON]


arg_expression=({arg_expr_block} | {arg_expr_chars_no_comma})+
arg_expr_block=[ETN_BRACEC_OPEN] ({arg_expr_block} | {arg_expr_chars})* [ETN_BRACEC_CLOSE]
arg_expr_chars=[ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_COMMA]
arg_expr_chars_no_comma=[ETN_ID, ETN_KW_SIGNED, ETN_KW_UNSIGNED, ETN_OP_PLUS-ETN_CONST_DOUBLE_E]

arg=[ETN_KW_OUT-ETN_KW_UNIFORM,ETN_KW_CONST]? {arg_type} [ETN_ID] {array_dim}* (([ETN_OP_ASSIGN] {arg_expression}) | ([ETN_OP_ELSE][ETN_ID]))?
var_arg=[ETN_VAARG]
args={arg} ([ETN_COMMA]{arg})* ([ETN_COMMA]{var_arg})?


kw_if=[ETN_KW_IF] [ETN_BRACEC_OPEN] {kw_expression} [ETN_BRACEC_CLOSE] {any_sentence} ([ETN_KW_ELSE]{any_sentence})?
kw_return=[ETN_KW_RETURN] {kw_expression}? [ETN_SEMICOLON]
kw_else=[ETN_KW_ELSE]
kw_break=[ETN_KW_BREAK][ETN_SEMICOLON]
kw_continue=[ETN_KW_CONTINUE][ETN_SEMICOLON]

for_inc_expression=({kw_expr_block} | {kw_expr_block_chars})+

kw_for=[ETN_KW_FOR] [ETN_BRACEC_OPEN] {kw_expression}?[ETN_SEMICOLON]{kw_expression}[ETN_SEMICOLON]{for_inc_expression}? [ETN_BRACEC_CLOSE] {any_sentence}
kw_do=[ETN_KW_DO] {any_sentence} [ETN_KW_WHILE] [ETN_BRACEC_OPEN] {kw_expression} [ETN_BRACEC_CLOSE][ETN_SEMICOLON]
kw_while=[ETN_KW_WHILE] [ETN_BRACEC_OPEN] {kw_expression} [ETN_BRACEC_CLOSE] {any_sentence}
kw_switch=[ETN_KW_SWITCH][ETN_BRACEC_OPEN]{kw_expression}[ETN_BRACEC_CLOSE] [ETN_BLOCK_OPEN] {any_sentence}+ [ETN_BLOCK_CLOSE]
kw_case=[ETN_KW_CASE]{kw_cexpr_block_chars}+[ETN_OP_ELSE]
kw_default=[ETN_KW_DEFAULT][ETN_OP_ELSE]


enum_def=[ETN_ID] ([ETN_OP_ASSIGN]	[ETN_ID, ETN_OP_PLUS-ETN_OP_OR, ETN_OP_GATE-ETN_CONST_DOUBLE_E, ETN_BRACEC_OPEN-ETN_BRACES_CLOSE]+)?
kw_enum=[ETN_KW_ENUM][ETN_ID][ETN_BLOCK_OPEN]	{enum_def} ([ETN_COMMA]{enum_def})*	[ETN_COMMA]?[ETN_BLOCK_CLOSE][ETN_SEMICOLON]






;single_expression_struct={expr_chars_struct}*([ETN_SEMICOLON] | [ETN_COMMA])
;expr_chars_struct=[ETN_ID, ETN_OP_PLUS-ETN_CONST_DOUBLE_E, ETN_BRACEC_OPEN-ETN_BRACES_CLOSE]

;****** struct ******
struct_var=[ETN_ID] {array_dim}*
struct_definition=[ETN_KW_LINEAR-ETN_KW_SAMPLE]* {id_def_strict} [ETN_SEMICOLON]

kw_struct=[ETN_KW_STRUCT] [ETN_ID]? [ETN_BLOCK_OPEN] {struct_definition}+ [ETN_BLOCK_CLOSE]

numbers=[ETN_CONST_INT,ETN_CONST_FLOAT,ETN_CONST_DOUBLE]

;****** cbuffer ******
kw_cbuffer=[ETN_KW_CBUFFER] [ETN_ID] {register_def}? [ETN_BLOCK_OPEN] ({var_def} | {empty_sentence})+ [ETN_BLOCK_CLOSE]



;****** Sampler ******
sampler_definition=[ETN_ID] [ETN_OP_ASSIGN] {const_expression}
sampler=[ETN_BLOCK_OPEN] ({sampler_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE]
sampler_in_array=[ETN_ID] | ([ETN_KW_SAMPLER,ETN_KW_SAMPLERSTATE] [ETN_BLOCK_OPEN] ({sampler_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE])
samplers_sampler_dimension={sampler_in_array} | {samplers_dimension}
samplers_dimension=[ETN_BLOCK_OPEN] {samplers_sampler_dimension} ([ETN_COMMA] {samplers_sampler_dimension})* [ETN_BLOCK_CLOSE]
samplers_array_size=[ETN_BRACES_OPEN] {const_expression} [ETN_BRACES_CLOSE]
samplers_array={samplers_array_size}+ [ETN_OP_ASSIGN] {samplers_dimension}
kw_sampler=[ETN_KW_SAMPLER,ETN_KW_SAMPLERSTATE,ETN_KW_SAMPLERCMPSTATE] [ETN_ID] ({samplers_array} | {sampler})

;****** RasterizerState ******
rs_definition=[ETN_ID] [ETN_OP_ASSIGN] {const_expression}
kw_rasterstate=[ETN_KW_RASTERSTATE] [ETN_ID] [ETN_BLOCK_OPEN] ({rs_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE] [ETN_SEMICOLON]

;****** BlendState ******
bs_array=[ETN_ID] [ETN_BRACES_OPEN][ETN_CONST_INT][ETN_BRACES_CLOSE] [ETN_OP_ASSIGN] {const_expression}
bs_definition=(([ETN_ID] [ETN_OP_ASSIGN] {const_expression}) | {bs_array}) 
kw_blendstate=[ETN_KW_BLENDSTATE] [ETN_ID] [ETN_BLOCK_OPEN] ({bs_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE] [ETN_SEMICOLON]

;****** DepthStencilState ******
dss_definition=[ETN_ID] [ETN_OP_ASSIGN] {const_expression}
kw_depthstencilstate=[ETN_KW_DEPTHSTENCILSTATE] [ETN_ID] [ETN_BLOCK_OPEN] ({dss_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE] [ETN_SEMICOLON]


;****** Pass ******
set_rs=[ETN_KW_SETRS] [ETN_BRACEC_OPEN] [ETN_ID] [ETN_BRACEC_CLOSE]
set_bs=[ETN_KW_SETBS] [ETN_BRACEC_OPEN] [ETN_ID] [ETN_COMMA] {const_expression} [ETN_COMMA] {const_expression} [ETN_BRACEC_CLOSE]
set_dss=[ETN_KW_SETDSS] [ETN_BRACEC_OPEN] [ETN_ID] [ETN_COMMA] {const_expression} [ETN_BRACEC_CLOSE]
set_shader=([ETN_KW_SETPS] | [ETN_KW_SETVS] | [ETN_KW_SETGS] | [ETN_KW_SETHS] | [ETN_KW_SETDS] | [ETN_KW_SETCS]) [ETN_BRACEC_OPEN] {const_expression} [ETN_COMMA] [ETN_ID] [ETN_BRACEC_CLOSE]
kw_defrange=[ETN_KW_DEFRANGE] [ETN_BRACEC_OPEN] [ETN_ID] [ETN_COMMA] {const_expression} [ETN_COMMA] {const_expression} [ETN_BRACEC_CLOSE]
kw_defconst=[ETN_ID] [ETN_OP_ASSIGN] ([ETN_CONST_STRING] | {const_expression})
pass_definition={set_rs} | {set_bs} | {set_dss} | {set_shader} | {kw_defrange} | {kw_defconst}

kw_pass=[ETN_KW_PASS] [ETN_ID] [ETN_BLOCK_OPEN] ({pass_definition} [ETN_SEMICOLON])+ [ETN_BLOCK_CLOSE]

;****** technique ******
kw_technique=[ETN_KW_TECH] [ETN_ID] [ETN_BLOCK_OPEN] {kw_pass}+ [ETN_BLOCK_CLOSE]

